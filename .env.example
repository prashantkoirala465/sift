# Copy to .env and fill in. See README.md for what each of these does and
# how to get the Google OAuth values.

# Required
SIFT_DB_PASSWORD=
SIFT_ENCRYPTION_KEY=   # openssl rand -base64 32

# Strongly recommended -- without this the web UI and API are unauthenticated
SIFT_AUTH_PASSWORD=

# Needed for Gmail sync; leave blank to run without it
SIFT_GOOGLE_CLIENT_ID=
SIFT_GOOGLE_CLIENT_SECRET=
SIFT_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional
SIFT_ANTHROPIC_API_KEY=
SIFT_SYNC_INTERVAL=5m
SIFT_ADDR=:8080
